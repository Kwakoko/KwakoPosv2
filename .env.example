# Local-development example values only. Never commit production credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kwakopos2?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=generate-a-random-local-secret-at-least-32-characters-long

# Production release-certification secrets belong in GitHub Actions Secrets.
# These are intentionally not populated in this example file.
KWAKOPOS_RELEASE_EVIDENCE_SIGNING_PRIVATE_KEY=
KWAKOPOS_RELEASE_EVIDENCE_SIGNING_PUBLIC_KEY=
KWAKOPOS_RELEASE_EVIDENCE_SIGNING_PUBLIC_KEY_FINGERPRINT=
