datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Tenant {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  branches         Branch[]
  users            User[]
  roles            Role[]
  products         Product[]
  productVariants  ProductVariant[]
  stockLedgers     StockLedger[]
  stockAdjustments StockAdjustment[]
  syncOperations   SyncOperation[]
  auditEvents      AuditEvent[]

  @@map("tenants")
}

model Branch {
  id               String            @id @default(uuid())
  tenantId         String
  name             String
  code             String
  isMain           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users            User[]
  products         Product[]
  productVariants  ProductVariant[]
  stockLedgers     StockLedger[]
  stockAdjustments StockAdjustment[]
  syncOperations   SyncOperation[]
  auditEvents      AuditEvent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id           String         @id @default(uuid())
  tenantId     String
  branchId     String
  email        String
  passwordHash String
  name         String
  roleId       String
  status       String         @default("ACTIVE")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role         Role           @relation(fields: [roleId], references: [id])
  sessions     DeviceSession[]

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@map("users")
}

model DeviceSession {
  id               String    @id @default(uuid())
  tenantId         String
  userId           String
  deviceId         String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, deviceId])
  @@map("device_sessions")
}

model Product {
  id               String           @id @default(uuid())
  tenantId         String
  branchId         String
  name             String
  description      String?
  sku              String
  category         String           @default("General")
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  stockLedgers     StockLedger[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId])
  @@map("products")
}

model ProductVariant {
  id               String            @id @default(uuid())
  tenantId         String
  branchId         String
  productId        String
  name             String
  sku              String
  barcode          String?
  price            Decimal           @db.Decimal(12, 2)
  costPrice        Decimal           @db.Decimal(12, 2)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLedgers     StockLedger[]
  stockAdjustments StockAdjustment[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId, productId])
  @@map("product_variants")
}

model StockLedger {
  id             String         @id @default(uuid())
  tenantId       String
  branchId       String
  productId      String
  variantId      String
  movementType   String // OPENING, PURCHASE, SALE, ADJUSTMENT, TRANSFER_IN, TRANSFER_OUT, RETURN, DAMAGE
  quantity       Decimal        @db.Decimal(12, 4)
  referenceType String
  referenceId   String?
  occurredAt     DateTime
  deviceId       String
  operationId    String
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, variantId])
  @@index([tenantId, branchId, occurredAt])
  @@map("stock_ledgers")
}

model StockAdjustment {
  id              String         @id @default(uuid())
  tenantId        String
  branchId        String
  variantId       String
  adjustmentType  String // INCREASE, DECREASE, SET
  quantityChange  Decimal        @db.Decimal(12, 4)
  reason          String
  referenceNote   String?
  status          String         @default("COMPLETED")
  createdByUserId String
  deviceId        String
  operationId     String
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, variantId])
  @@map("stock_adjustments")
}

model SyncOperation {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String
  deviceId        String
  operationId     String
  entityType      String // Product, ProductVariant, StockAdjustment, StockLedger
  entityId        String
  operationType   String // CREATE, UPDATE, DELETE
  payload         Json
  status          String    @default("PROCESSED")
  idempotencyKey  String    @unique
  clientCreatedAt DateTime
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceId, operationId])
  @@index([tenantId, branchId, createdAt])
  @@map("sync_operations")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  userId     String
  deviceId   String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, createdAt])
  @@map("audit_events")
}
