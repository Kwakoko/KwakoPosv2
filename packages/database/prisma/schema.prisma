// ==========================================
// PHASE 5: RELEASE MANAGEMENT & DEPLOYMENTS
// ==========================================

model AppVersion {
  id                  String               @id @default(uuid())
  version             String               @unique
  major               Int
  minor               Int
  patch               Int
  prerelease          String?
  releaseType         String               @default("PATCH") // MAJOR, MINOR, PATCH
  gitTag              String
  commitHash          String
  artifactDigest      String?
  imageDigest         String?
  schemaVersion       String?
  sbomReference       String?
  provenanceReference String?
  releaseState        String               @default("RELEASED") // DRAFT, VALIDATING, QUALITY_PASSED, SECURITY_PASSED, BUILT, ATTESTED, STAGING, STAGING_CERTIFIED, PRODUCTION_READY, CANARY, PROMOTING, PRODUCTION, VERIFIED, RELEASED, FAILED, BLOCKED, ROLLED_BACK
  releaseRisk         String               @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  releaseNotes        String?
  releaseDate         DateTime             @default(now())
  deploymentStatus    String               @default("DEPLOYED") // PENDING, DEPLOYING, DEPLOYED, ROLLED_BACK, FAILED
  buildNumber         Int                  @default(1)
  createdBy           String               @default("AUTOMATED_CI_CD")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  changes             VersionChange[]
  deployments         DeploymentHistory[]
  gates               ReleaseQualityGate[]
  approvals           ReleaseApproval[]

  @@map("app_versions")
}

model VersionChange {
  id                 String     @id @default(uuid())
  appVersionId       String
  module             String     @default("CORE")
  feature            String
  changeType         String     @default("FEAT") // FEAT, FIX, PERF, REFACTOR, SECURITY, DOCS, BREAKING
  scope              String?    @default("platform")
  commit             String
  prNumber           Int?
  developer          String     @default("CI_BOT")
  breakingChangeFlag Boolean    @default(false)
  migrationFlag      Boolean    @default(false)
  securityFlag       Boolean    @default(false)
  timestamp          DateTime   @default(now())
  appVersion         AppVersion @relation(fields: [appVersionId], references: [id], onDelete: Cascade)

  @@index([appVersionId])
  @@index([module])
  @@map("version_changes")
}

model DeploymentHistory {
  id                  String            @id @default(uuid())
  appVersionId        String
  environment         String            @default("production") // development, staging, preproduction, production
  revision            String?
  artifactDigest      String?
  deploymentStrategy  String            @default("CANARY") // CANARY, BLUE_GREEN, ROLLING, IMMEDIATE
  canaryPercentage    Int               @default(100)
  deploymentStart     DateTime          @default(now())
  deploymentEnd       DateTime?
  durationSeconds     Int               @default(0)
  status              String            @default("SUCCESSFUL") // IN_PROGRESS, SUCCESSFUL, FAILED, ROLLED_BACK
  rollbackStatus      String?
  rollbackReason      String?
  healthResult        String?           @default("100% HEALTHY")
  rollbackInformation String?
  createdAt           DateTime          @default(now())
  appVersion          AppVersion        @relation(fields: [appVersionId], references: [id], onDelete: Cascade)
  events              DeploymentEvent[]

  @@index([appVersionId])
  @@index([environment, status])
  @@map("deployment_history")
}

model DeploymentEvent {
  id           String            @id @default(uuid())
  deploymentId String
  eventType    String // DEPLOYMENT_START, CANARY_PROMOTED, SLO_BREACH, HEALTH_CHECK_PASS, ROLLBACK_INITIATED
  timestamp    DateTime          @default(now())
  source       String            @default("AUTOMATED_CD")
  severity     String            @default("INFO") // INFO, WARN, ERROR, CRITICAL
  message      String
  metric       String?
  threshold    String?
  decision     String?
  deployment   DeploymentHistory @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@map("deployment_events")
}

model ReleaseQualityGate {
  id            String     @id @default(uuid())
  appVersionId  String
  gate          String
  status        String     @default("PASSED") // PASSED, FAILED, SKIPPED
  score         Float      @default(100.0)
  evidence      String
  failureReason String?
  timestamp     DateTime   @default(now())
  appVersion    AppVersion @relation(fields: [appVersionId], references: [id], onDelete: Cascade)

  @@index([appVersionId])
  @@map("release_quality_gates")
}

model ReleaseAttestation {
  id                    String   @id @default(uuid())
  artifactDigest        String   @unique
  provenance            String
  sbom                  String
  signer                String   @default("github-actions[bot]")
  verificationStatus    String   @default("VERIFIED") // VERIFIED, REJECTED, UNVERIFIED
  verificationTimestamp DateTime @default(now())

  @@map("release_attestations")
}

model ReleaseApproval {
  id           String     @id @default(uuid())
  appVersionId String
  approver     String
  policy       String     @default("HIGH_RISK_MANUAL_APPROVAL")
  decision     String     @default("APPROVED") // APPROVED, REJECTED, PENDING
  timestamp    DateTime   @default(now())
  reason       String
  appVersion   AppVersion @relation(fields: [appVersionId], references: [id], onDelete: Cascade)

  @@index([appVersionId])
  @@map("release_approvals")
}

model ReleaseCandidate {
  id             String   @id @default(uuid())
  rcNumber       String   @unique // e.g. RC-2026-08-28-001
  version        String
  gitSha         String
  artifactDigest String
  riskScore      Float    @default(15.0)
  riskLevel      String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status         String   @default("VALIDATING") // DRAFT, VALIDATING, CERTIFIED, PROMOTED, FAILED
  createdAt      DateTime @default(now())

  @@map("release_candidates")
}

model ReleasePolicy {
  id            String   @id @default(uuid())
  policyVersion String   @default("production-release-v2")
  environment   String   @default("production")
  definition    String // YAML / JSON policy
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("release_policies")
}

model ReleaseArtifact {
  id           String   @id @default(uuid())
  appVersionId String
  artifactName String
  digest       String
  registry     String   @default("ghcr.io/kwakopos")
  sbom         String
  provenance   String
  attestation  String
  createdAt    DateTime @default(now())

  @@index([appVersionId])
  @@map("release_artifacts")
}

model CertificationRun {
  id           String   @id @default(uuid())
  appVersionId String
  suite        String // CORE, AUTH, POS, INVENTORY, STOCK_LEDGER, OFFLINE_SYNC, PWA
  status       String   @default("PASS") // PASS, WARN, FAIL
  score        Float    @default(100.0)
  evidence     String
  timestamp    DateTime @default(now())

  @@index([appVersionId])
  @@map("certification_runs")
}

model RolloutStage {
  id                String    @id @default(uuid())
  deploymentId      String
  stage             String // INTERNAL, CANARY_TENANT, PERCENT_1, PERCENT_5, PERCENT_25, PERCENT_50, PERCENT_100
  trafficPercentage Int
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  decision          String    @default("PROMOTED")

  @@index([deploymentId])
  @@map("rollout_stages")
}

model DeploymentHealth {
  id            String   @id @default(uuid())
  deploymentId  String
  metric        String // ERROR_RATE, LATENCY_P95, AVAILABILITY, SYNC_FAILURE_RATE
  observedValue String
  threshold     String
  status        String   @default("HEALTHY") // HEALTHY, BREACHED
  timestamp     DateTime @default(now())

  @@index([deploymentId])
  @@map("deployment_health")
}

model ReleaseIncident {
  id            String   @id @default(uuid())
  appVersionId  String
  incidentCode  String
  detectionTime DateTime @default(now())
  impact        String
  action        String   @default("AUTOMATED_ROLLBACK")
  recovery      String
  resolution    String?

  @@index([appVersionId])
  @@map("release_incidents")
}

