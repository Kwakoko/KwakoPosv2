datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  status                 String                  @default("ACTIVE")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  branches               Branch[]
  users                  User[]
  roles                  Role[]
  products               Product[]
  productVariants        ProductVariant[]
  categories             Category[]
  brands                 Brand[]
  unitsOfMeasure         UnitOfMeasure[]
  customers              Customer[]
  suppliers              Supplier[]
  inventoryLocations     InventoryLocation[]
  stockLedgers           StockLedger[]
  stockAdjustments       StockAdjustment[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  salesOrders            SalesOrder[]
  sales                  Sale[]
  returns                Return[]
  payments               Payment[]
  cashSessions           CashSession[]
  expenses               Expense[]
  priceLists             PriceList[]
  taxes                  Tax[]
  accounts               Account[]
  fiscalYears            FiscalYear[]
  accountingPeriods      AccountingPeriod[]
  journalEntries         JournalEntry[]
  customerInvoices       CustomerInvoice[]
  supplierInvoices       SupplierInvoice[]
  bankAccounts           BankAccount[]
  budgets                Budget[]
  costCenters            CostCenter[]
  exchangeRates          ExchangeRate[]
  financialAnomalies     FinancialAnomaly[]
  departments            Department[]
  jobPositions           JobPosition[]
  employees              Employee[]
  employmentRecords      EmploymentRecord[]
  shiftTemplates         ShiftTemplate[]
  workforceSchedules     WorkforceSchedule[]
  attendanceRecords      AttendanceRecord[]
  timesheets             Timesheet[]
  leaveTypes             LeaveType[]
  leaveRequests          LeaveRequest[]
  workforceTasks         WorkforceTask[]
  workOrders             WorkOrder[]
  employeeSkills         EmployeeSkill[]
  employeeCertifications EmployeeCertification[]
  performanceReviews     PerformanceReview[]
  commissionRecords      CommissionRecord[]
  payrollInputs          PayrollInput[]
  syncOperations         SyncOperation[]
  auditEvents            AuditEvent[]
  priceHistories         ProductPriceHistory[]
  branchStocks           ProductBranchStock[]
  receipts               Receipt[]
  receiptTemplates       ReceiptTemplate[]
  traVfdConfigs          TraVfdConfig[]
  traVfdFiscalizations   TraVfdFiscalization[]
  traVfdOutbox           TraVfdOutbox[]

  @@map("tenants")
}

model Branch {
  id                   String                @id @default(uuid())
  tenantId             String
  name                 String
  code                 String
  isMain               Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                User[]
  products             Product[]
  productVariants      ProductVariant[]
  categories           Category[]
  brands               Brand[]
  unitsOfMeasure       UnitOfMeasure[]
  customers            Customer[]
  suppliers            Supplier[]
  inventoryLocations   InventoryLocation[]
  stockLedgers         StockLedger[]
  stockAdjustments     StockAdjustment[]
  purchaseOrders       PurchaseOrder[]
  purchaseReceipts     PurchaseReceipt[]
  salesOrders          SalesOrder[]
  sales                Sale[]
  returns              Return[]
  payments             Payment[]
  cashSessions         CashSession[]
  expenses             Expense[]
  priceLists           PriceList[]
  taxes                Tax[]
  accounts             Account[]
  journalEntries       JournalEntry[]
  customerInvoices     CustomerInvoice[]
  supplierInvoices     SupplierInvoice[]
  bankAccounts         BankAccount[]
  budgets              Budget[]
  costCenters          CostCenter[]
  financialAnomalies   FinancialAnomaly[]
  departments          Department[]
  employees            Employee[]
  shiftTemplates       ShiftTemplate[]
  workforceSchedules   WorkforceSchedule[]
  attendanceRecords    AttendanceRecord[]
  timesheets           Timesheet[]
  leaveRequests        LeaveRequest[]
  workforceTasks       WorkforceTask[]
  workOrders           WorkOrder[]
  performanceReviews   PerformanceReview[]
  commissionRecords    CommissionRecord[]
  payrollInputs        PayrollInput[]
  syncOperations       SyncOperation[]
  auditEvents          AuditEvent[]
  priceHistories       ProductPriceHistory[]
  branchStocks         ProductBranchStock[]
  receipts             Receipt[]
  receiptTemplates     ReceiptTemplate[]
  traVfdConfigs        TraVfdConfig[]
  traVfdFiscalizations TraVfdFiscalization[]
  traVfdOutbox         TraVfdOutbox[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id           String          @id @default(uuid())
  tenantId     String
  branchId     String
  email        String
  passwordHash String
  name         String
  roleId       String
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role         Role            @relation(fields: [roleId], references: [id])
  sessions     DeviceSession[]
  cashSessions CashSession[]

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@map("users")
}

model DeviceSession {
  id               String    @id @default(uuid())
  tenantId         String
  userId           String
  deviceId         String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, deviceId])
  @@map("device_sessions")
}

model Category {
  id          String    @id @default(uuid())
  tenantId    String
  branchId    String
  name        String
  code        String
  parentId    String?
  description String?
  color       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  origin    String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
  @@map("brands")
}

model UnitOfMeasure {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, symbol])
  @@map("units_of_measure")
}

model InventoryLocation {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, code])
  @@map("inventory_locations")
}

model Customer {
  id             String       @id @default(uuid())
  tenantId       String
  branchId       String
  customerCode   String
  name           String
  phone          String?
  email          String?
  address        String?
  creditLimit    Decimal      @default(0) @db.Decimal(12, 2)
  currentBalance Decimal      @default(0) @db.Decimal(12, 2)
  openingBalance Decimal      @default(0) @db.Decimal(12, 2)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  salesOrders    SalesOrder[]
  sales          Sale[]
  returns        Return[]
  payments       Payment[]

  @@unique([tenantId, branchId, customerCode])
  @@index([tenantId, branchId])
  @@map("customers")
}

model Supplier {
  id                 String            @id @default(uuid())
  tenantId           String
  branchId           String
  supplierCode       String
  name               String
  phone              String?
  email              String?
  address            String?
  taxPin             String?
  outstandingBalance Decimal           @default(0) @db.Decimal(12, 2)
  status             String            @default("ACTIVE")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  payments           Payment[]

  @@unique([tenantId, branchId, supplierCode])
  @@index([tenantId, branchId])
  @@map("suppliers")
}

model Product {
  id                      String                @id @default(uuid())
  tenantId                String
  branchId                String
  categoryId              String?
  brandId                 String?               @map("brand_id")
  supplierId              String?
  taxId                   String?
  name                    String
  description             String?
  sku                     String
  category                String                @default("General")
  buyingPrice             Decimal               @default(0) @db.Decimal(12, 2)
  sellingPrice            Decimal               @default(0) @db.Decimal(12, 2)
  currentMarginAmount     Decimal               @default(0) @db.Decimal(12, 2)
  currentMarginPercentage Decimal               @default(0) @db.Decimal(7, 2)
  activePriceVersionId    String?
  images                  String[]              @default([])
  hasVariants             Boolean               @default(false)
  totalStock              Decimal               @default(0) @db.Decimal(12, 4)
  reservedStock           Decimal               @default(0) @db.Decimal(12, 4)
  availableStock          Decimal               @default(0) @db.Decimal(12, 4)
  lowStockVariantsCount   Int                   @default(0)
  isActive                Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                  Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryRel             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandRel                Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants                ProductVariant[]
  stockLedgers            StockLedger[]
  priceHistories          ProductPriceHistory[]
  branchStocks            ProductBranchStock[]
  saleLines               SaleLine[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId])
  @@map("products")
}

model ProductVariant {
  id                      String                @id @default(uuid())
  tenantId                String
  branchId                String
  productId               String
  name                    String
  sku                     String
  barcode                 String?
  inheritBuyingPrice      Boolean               @default(true)
  inheritSellingPrice     Boolean               @default(true)
  price                   Decimal               @default(0) @db.Decimal(12, 2)
  costPrice               Decimal               @default(0) @db.Decimal(12, 2)
  currentMarginAmount     Decimal               @default(0) @db.Decimal(12, 2)
  currentMarginPercentage Decimal               @default(0) @db.Decimal(7, 2)
  activePriceVersionId    String?
  inventoryQuantity       Decimal               @default(0) @db.Decimal(12, 4)
  reservedQuantity        Decimal               @default(0) @db.Decimal(12, 4)
  reorderLevel            Decimal               @default(0) @db.Decimal(12, 4)
  imageUrl                String?
  attributes              Json?
  isActive                Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                  Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product                 Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLedgers            StockLedger[]
  stockAdjustments        StockAdjustment[]
  priceHistories          ProductPriceHistory[]
  branchStocks            ProductBranchStock[]
  purchaseOrderItems      PurchaseOrderItem[]
  purchaseReceiptItems    PurchaseReceiptItem[]
  salesOrderItems         SalesOrderItem[]
  saleLines               SaleLine[]
  returnLines             ReturnLine[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId, productId])
  @@map("product_variants")
}

model ProductPriceHistory {
  id                   String          @id @default(uuid())
  tenantId             String
  branchId             String
  productId            String
  variantId            String?
  versionNumber        Int
  previousBuyingPrice  Decimal         @default(0) @db.Decimal(15, 2)
  newBuyingPrice       Decimal         @db.Decimal(15, 2)
  previousSellingPrice Decimal         @default(0) @db.Decimal(15, 2)
  newSellingPrice      Decimal         @db.Decimal(15, 2)
  marginAmount         Decimal         @db.Decimal(15, 2)
  marginPercentage     Decimal         @db.Decimal(7, 2)
  changeType           String          @default("MANUAL_ADJUSTMENT") // INITIAL_PRICE, PRICE_UPDATE, PROMOTION, SUPPLIER_CHANGE, MANUAL_ADJUSTMENT, BULK_UPDATE
  changeReason         String
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  changedByUserId      String?
  deviceId             String
  idempotencyKey       String          @unique
  createdAt            DateTime        @default(now())
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant              ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, productId])
  @@index([tenantId, branchId, variantId])
  @@index([tenantId, branchId, versionNumber])
  @@map("product_price_history")
}

model StockLedger {
  id             String         @id @default(uuid())
  tenantId       String
  branchId       String
  warehouseId    String?
  productId      String
  variantId      String
  movementType   String // OPENING_STOCK, PURCHASE_RECEIVE, CUSTOMER_RETURN, TRANSFER_IN, PRODUCTION_OUTPUT, ADJUSTMENT_GAIN, SALE, SUPPLIER_RETURN, TRANSFER_OUT, DAMAGE, EXPIRY, ADJUSTMENT_LOSS, PRODUCTION_USAGE, SALE_CORRECTION
  referenceType  String
  referenceId    String?
  quantityBefore Decimal        @default(0) @db.Decimal(15, 4)
  quantityChange Decimal        @db.Decimal(15, 4)
  quantity       Decimal        @db.Decimal(15, 4)
  quantityAfter  Decimal        @default(0) @db.Decimal(15, 4)
  unitCost       Decimal        @default(0) @db.Decimal(15, 2)
  totalCost      Decimal        @default(0) @db.Decimal(15, 2)
  userId         String?
  deviceId       String
  operationId    String
  idempotencyKey String
  notes          String?
  synced         Boolean        @default(true)
  occurredAt     DateTime
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, idempotencyKey])
  @@index([tenantId, branchId, variantId])
  @@index([tenantId, branchId, occurredAt])
  @@map("stock_ledgers")
}

model ProductBranchStock {
  id              String         @id @default(uuid())
  tenantId        String
  branchId        String
  warehouseId     String?
  productId       String
  variantId       String
  currentQuantity Decimal        @default(0) @db.Decimal(15, 4)
  averageCost     Decimal        @default(0) @db.Decimal(15, 2)
  stockValue      Decimal        @default(0) @db.Decimal(15, 2)
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchId, warehouseId, productId, variantId])
  @@index([tenantId, branchId, variantId])
  @@map("product_branch_stock")
}

model StockAdjustment {
  id              String         @id @default(uuid())
  tenantId        String
  branchId        String
  variantId       String
  adjustmentType  String // INCREASE, DECREASE, SET
  quantityChange  Decimal        @db.Decimal(12, 4)
  reason          String
  referenceNote   String?
  status          String         @default("COMPLETED")
  createdByUserId String
  deviceId        String
  operationId     String
  idempotencyKey  String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, idempotencyKey])
  @@index([tenantId, branchId, variantId])
  @@map("stock_adjustments")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  tenantId         String
  branchId         String
  orderNumber      String
  supplierId       String
  status           String              @default("DRAFT") // DRAFT, APPROVED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalAmount      Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  createdById      String?
  approvedById     String?
  orderedAt        DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items            PurchaseOrderItem[]
  purchaseReceipts PurchaseReceipt[]

  @@unique([tenantId, branchId, orderNumber])
  @@index([tenantId, branchId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Decimal        @db.Decimal(12, 4)
  quantityReceived Decimal        @default(0) @db.Decimal(12, 4)
  unitCost         Decimal        @db.Decimal(12, 2)
  totalCost        Decimal        @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id              String                @id @default(uuid())
  tenantId        String
  branchId        String
  receiptNumber   String
  purchaseOrderId String?
  supplierId      String
  receivedAt      DateTime              @default(now())
  createdById     String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  items           PurchaseReceiptItem[]
  payments        Payment[]

  @@unique([tenantId, branchId, receiptNumber])
  @@index([tenantId, branchId, supplierId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                String          @id @default(uuid())
  purchaseReceiptId String
  variantId         String
  quantityReceived  Decimal         @db.Decimal(12, 4)
  unitCost          Decimal         @db.Decimal(12, 2)
  totalCost         Decimal         @db.Decimal(12, 2)
  batchNumber       String?
  expiryDate        DateTime?
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("purchase_receipt_items")
}

model SalesOrder {
  id          String           @id @default(uuid())
  tenantId    String
  branchId    String
  orderNumber String
  customerId  String?
  status      String           @default("PENDING") // PENDING, CONFIRMED, FULFILLED, CANCELLED
  totalAmount Decimal          @default(0) @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer?        @relation(fields: [customerId], references: [id])
  items       SalesOrderItem[]

  @@unique([tenantId, branchId, orderNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String         @id @default(uuid())
  salesOrderId String
  variantId    String
  quantity     Decimal        @db.Decimal(12, 4)
  unitPrice    Decimal        @db.Decimal(12, 2)
  totalPrice   Decimal        @db.Decimal(12, 2)
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

model Sale {
  id             String       @id @default(uuid())
  tenantId       String
  branchId       String
  saleNumber     String
  customerId     String?
  cashSessionId  String?
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal      @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal      @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal      @default(0) @db.Decimal(12, 2)
  totalCost      Decimal      @default(0) @db.Decimal(12, 2)
  grossProfit    Decimal      @default(0) @db.Decimal(12, 2)
  status         String       @default("COMPLETED") // COMPLETED, CANCELLED, REFUNDED
  paymentStatus  String       @default("PAID") // PAID, PARTIAL, UNPAID
  deviceId       String
  operationId    String
  idempotencyKey String       @unique
  soldById       String?
  soldAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id])
  lines          SaleLine[]
  payments       Payment[]
  returns        Return[]

  @@unique([tenantId, branchId, saleNumber])
  @@index([tenantId, branchId, soldAt])
  @@map("sales")
}

model SaleLine {
  id             String         @id @default(uuid())
  saleId         String
  productId      String
  variantId      String
  quantity       Decimal        @db.Decimal(12, 4)
  unitPrice      Decimal        @db.Decimal(12, 2)
  unitCost       Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal        @db.Decimal(12, 2)
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([saleId, variantId])
  @@map("sale_lines")
}

model Return {
  id                String       @id @default(uuid())
  tenantId          String
  branchId          String
  returnNumber      String
  originalSaleId    String?
  customerId        String?
  reason            String
  refundType        String       @default("CASH") // CASH, STORE_CREDIT, BANK, MOBILE_MONEY
  totalRefundAmount Decimal      @db.Decimal(12, 2)
  status            String       @default("COMPLETED")
  authorizedById    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  originalSale      Sale?        @relation(fields: [originalSaleId], references: [id])
  customer          Customer?    @relation(fields: [customerId], references: [id])
  lines             ReturnLine[]

  @@unique([tenantId, branchId, returnNumber])
  @@map("returns")
}

model ReturnLine {
  id               String         @id @default(uuid())
  returnId         String
  variantId        String
  quantityReturned Decimal        @db.Decimal(12, 4)
  refundUnitPrice  Decimal        @db.Decimal(12, 2)
  refundLineTotal  Decimal        @db.Decimal(12, 2)
  condition        String         @default("GOOD") // GOOD, DAMAGED, DEFECTIVE
  returnRel        Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("return_lines")
}

model Payment {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String
  paymentNumber     String
  saleId            String?
  purchaseReceiptId String?
  customerId        String?
  supplierId        String?
  amount            Decimal          @db.Decimal(12, 2)
  paymentMethod     String           @default("CASH") // CASH, CARD, BANK, MOBILE_MONEY, CREDIT, OTHER
  provider          String? // MPESA, AIRTEL_MONEY, TIGO_PESA, HALOPESA, NMB, CRDB, CASH
  providerReference String?
  status            String           @default("COMPLETED") // COMPLETED, PENDING, FAILED, REFUNDED
  paidAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sale              Sale?            @relation(fields: [saleId], references: [id])
  purchaseReceipt   PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id])
  customer          Customer?        @relation(fields: [customerId], references: [id])
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])

  @@unique([tenantId, branchId, paymentNumber])
  @@index([tenantId, branchId, paidAt])
  drawerOperationId String? @unique
  drawerOperation DrawerOperation? @relation("PaymentDrawerOperation", fields: [drawerOperationId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model CashSession {
  id                String    @id @default(uuid())
  tenantId          String
  branchId          String
  sessionNumber     String
  cashierId         String
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  openingCash       Decimal   @default(0) @db.Decimal(12, 2)
  closingCash       Decimal?  @db.Decimal(12, 2)
  expectedCash      Decimal   @default(0) @db.Decimal(12, 2)
  actualCash        Decimal?  @db.Decimal(12, 2)
  cashSalesTotal    Decimal   @default(0) @db.Decimal(12, 2)
  cashRefundsTotal  Decimal   @default(0) @db.Decimal(12, 2)
  cashExpensesTotal Decimal   @default(0) @db.Decimal(12, 2)
  variance          Decimal?  @db.Decimal(12, 2)
  status            String    @default("OPEN") // OPEN, ACTIVE, CLOSE_REQUESTED, CLOSED
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier           User      @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  sales             Sale[]
  expenses          Expense[]
  drawerOperations  DrawerOperation[]

  @@unique([tenantId, branchId, sessionNumber])
  @@index([tenantId, branchId, cashierId])
  @@map("cash_sessions")
}

model DrawerOperation {
  id            String    @id @default(uuid())
  tenantId      String
  branchId      String
  cashSessionId String?
  paymentId     String?
  saleId        String?
  operationType String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  lastError     String?
  deviceId      String
  requestedById String
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payment       Payment?  @relation("PaymentDrawerOperation")
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, status, requestedAt])
  @@index([tenantId, branchId, operationType, createdAt])
  @@index([tenantId, branchId, cashSessionId])
  @@map("drawer_operations")
}

model Expense {
  id             String       @id @default(uuid())
  tenantId       String
  branchId       String
  cashSessionId  String?
  category       String
  amount         Decimal      @db.Decimal(12, 2)
  reason         String
  authorizedById String?
  incurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id])

  @@index([tenantId, branchId, incurredAt])
  @@map("expenses")
}

model PriceList {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  currency  String   @default("TZS")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, code])
  @@map("price_lists")
}

model Tax {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  name        String
  code        String
  rate        Decimal  @db.Decimal(5, 2) // e.g., 18.00 for 18%
  isInclusive Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, code])
  @@map("taxes")
}

model SyncOperation {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String
  deviceId        String
  operationId     String
  entityType      String // Product, ProductVariant, StockAdjustment, StockLedger, Customer, Supplier, Sale, PurchaseOrder, Payment, CashSession
  entityId        String
  operationType   String // CREATE, UPDATE, DELETE
  payload         Json
  status          String    @default("PROCESSED")
  idempotencyKey  String
  clientCreatedAt DateTime
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, deviceId, operationId])
  @@unique([tenantId, branchId, idempotencyKey])
  @@index([tenantId, branchId, createdAt])
  @@map("sync_operations")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  userId     String
  deviceId   String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, createdAt])
  @@map("audit_events")
}

model SyncDeadLetter {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  deviceId    String
  operationId String
  entityType  String
  payload     Json
  errorReason String
  createdAt   DateTime @default(now())

  @@index([tenantId, branchId, createdAt])
  @@map("sync_dead_letters")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  tenantId    String?
  branchId    String?
  key         String
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, tenantId, branchId])
  @@map("feature_flags")
}

// =========================================================================
// PHASE 2: FINANCE & OPERATIONAL CONTROL MODELS
// =========================================================================

model Account {
  id             String        @id @default(uuid())
  tenantId       String
  branchId       String?
  accountCode    String
  name           String
  accountClass   String // ASSET, LIABILITY, EQUITY, REVENUE, COGS, EXPENSE, OTHER_INCOME, OTHER_EXPENSE
  accountGroup   String // e.g. CURRENT_ASSET, CASH, BANK, ACCOUNTS_RECEIVABLE, INVENTORY, CURRENT_LIABILITY, ACCOUNTS_PAYABLE, TAX_PAYABLE
  currency       String        @default("TZS")
  isSystem       Boolean       @default(false)
  isActive       Boolean       @default(true)
  currentBalance Decimal       @default(0) @db.Decimal(14, 2)
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id])
  journalLines   JournalLine[]
  budgetLines    BudgetLine[]

  @@unique([tenantId, accountCode])
  @@index([tenantId, accountClass])
  @@map("accounts")
}

model FiscalYear {
  id                String             @id @default(uuid())
  tenantId          String
  name              String // e.g. "FY 2026"
  startDate         DateTime
  endDate           DateTime
  status            String             @default("OPEN") // OPEN, CLOSING, CLOSED, LOCKED
  isClosed          Boolean            @default(false)
  closedAt          DateTime?
  closedById        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountingPeriods AccountingPeriod[]

  @@unique([tenantId, name])
  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String         @id @default(uuid())
  tenantId     String
  fiscalYearId String
  periodNumber Int // 1 to 12
  name         String // e.g. "2026-01"
  startDate    DateTime
  endDate      DateTime
  status       String         @default("OPEN") // OPEN, CLOSING, CLOSED, LOCKED
  closedAt     DateTime?
  closedById   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals     JournalEntry[]

  @@unique([tenantId, fiscalYearId, periodNumber])
  @@map("accounting_periods")
}

model JournalEntry {
  id                  String            @id @default(uuid())
  tenantId            String
  branchId            String
  accountingPeriodId  String?
  journalNumber       String
  entryDate           DateTime          @default(now())
  postingDate         DateTime          @default(now())
  sourceType          String // SALE, PURCHASE, PAYMENT, EXPENSE, RETURN, TRANSFER, CASH_SESSION, MANUAL, REVERSAL
  sourceId            String?
  description         String
  currency            String            @default("TZS")
  exchangeRate        Decimal           @default(1.0) @db.Decimal(10, 4)
  totalDebit          Decimal           @db.Decimal(14, 2)
  totalCredit         Decimal           @db.Decimal(14, 2)
  status              String            @default("POSTED") // DRAFT, PENDING_APPROVAL, POSTED, REVERSED
  isReversal          Boolean           @default(false)
  reversalOfJournalId String?
  reversalReason      String?
  createdById         String?
  postedById          String?
  postedAt            DateTime?         @default(now())
  idempotencyKey      String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  accountingPeriod    AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id])
  lines               JournalLine[]

  @@unique([tenantId, branchId, journalNumber])
  @@index([tenantId, branchId, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  costCenterId   String?
  description    String?
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)
  currency       String       @default("TZS")
  exchangeRate   Decimal      @default(1.0) @db.Decimal(10, 4)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@index([journalEntryId, accountId])
  @@map("journal_lines")
}

model CustomerInvoice {
  id            String                @id @default(uuid())
  tenantId      String
  branchId      String
  customerId    String
  saleId        String?
  invoiceNumber String
  invoiceDate   DateTime              @default(now())
  dueDate       DateTime
  subtotal      Decimal               @db.Decimal(14, 2)
  taxTotal      Decimal               @default(0) @db.Decimal(14, 2)
  discountTotal Decimal               @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal               @db.Decimal(14, 2)
  amountPaid    Decimal               @default(0) @db.Decimal(14, 2)
  balanceDue    Decimal               @db.Decimal(14, 2)
  status        String                @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines         CustomerInvoiceLine[]
  allocations   PaymentAllocation[]

  @@unique([tenantId, branchId, invoiceNumber])
  @@index([tenantId, customerId, status])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id                String          @id @default(uuid())
  customerInvoiceId String
  variantId         String?
  description       String
  quantity          Decimal         @db.Decimal(12, 4)
  unitPrice         Decimal         @db.Decimal(14, 2)
  taxRate           Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  customerInvoice   CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)

  @@map("customer_invoice_lines")
}

model SupplierInvoice {
  id                String                @id @default(uuid())
  tenantId          String
  branchId          String
  supplierId        String
  purchaseReceiptId String?
  invoiceNumber     String
  invoiceDate       DateTime              @default(now())
  dueDate           DateTime
  subtotal          Decimal               @db.Decimal(14, 2)
  taxTotal          Decimal               @default(0) @db.Decimal(14, 2)
  grandTotal        Decimal               @db.Decimal(14, 2)
  amountPaid        Decimal               @default(0) @db.Decimal(14, 2)
  balanceDue        Decimal               @db.Decimal(14, 2)
  status            String                @default("RECEIVED") // RECEIVED, APPROVED, PARTIALLY_PAID, PAID, OVERDUE, REJECTED
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines             SupplierInvoiceLine[]
  allocations       PaymentAllocation[]

  @@unique([tenantId, branchId, invoiceNumber])
  @@index([tenantId, supplierId, status])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id                String          @id @default(uuid())
  supplierInvoiceId String
  variantId         String?
  description       String
  quantity          Decimal         @db.Decimal(12, 4)
  unitCost          Decimal         @db.Decimal(14, 2)
  taxRate           Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  @@map("supplier_invoice_lines")
}

model PaymentAllocation {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String
  paymentId         String
  customerInvoiceId String?
  supplierInvoiceId String?
  allocatedAmount   Decimal          @db.Decimal(14, 2)
  allocatedAt       DateTime         @default(now())
  createdById       String?
  createdAt         DateTime         @default(now())
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  @@index([tenantId, paymentId])
  @@map("payment_allocations")
}

model BankAccount {
  id             String            @id @default(uuid())
  tenantId       String
  branchId       String
  accountName    String
  bankName       String // e.g. "NMB", "CRDB", "Stanbic", "NBC"
  accountNumber  String
  currency       String            @default("TZS")
  openingBalance Decimal           @default(0) @db.Decimal(14, 2)
  currentBalance Decimal           @default(0) @db.Decimal(14, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]

  @@unique([tenantId, accountNumber])
  @@map("bank_accounts")
}

model BankTransaction {
  id                   String      @id @default(uuid())
  tenantId             String
  branchId             String
  bankAccountId        String
  transactionDate      DateTime
  transactionType      String // DEPOSIT, WITHDRAWAL, TRANSFER_IN, TRANSFER_OUT, FEE, INTEREST, ADJUSTMENT
  amount               Decimal     @db.Decimal(14, 2)
  reference            String
  description          String?
  reconciled           Boolean     @default(false)
  reconciledAt         DateTime?
  matchedJournalLineId String?
  createdAt            DateTime    @default(now())
  bankAccount          BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, transactionDate])
  @@map("bank_transactions")
}

model Budget {
  id          String       @id @default(uuid())
  tenantId    String
  branchId    String
  name        String
  fiscalYear  String // e.g. "2026"
  period      String? // Optional month/quarter: "Q1", "2026-01"
  totalBudget Decimal      @db.Decimal(14, 2)
  status      String       @default("APPROVED") // DRAFT, APPROVED, ARCHIVED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines       BudgetLine[]

  @@unique([tenantId, branchId, name, fiscalYear])
  @@map("budgets")
}

model BudgetLine {
  id             String      @id @default(uuid())
  budgetId       String
  accountId      String
  costCenterId   String?
  budgetedAmount Decimal     @db.Decimal(14, 2)
  actualAmount   Decimal     @default(0) @db.Decimal(14, 2)
  varianceAmount Decimal     @default(0) @db.Decimal(14, 2)
  budget         Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id])

  @@map("budget_lines")
}

model CostCenter {
  id           String        @id @default(uuid())
  tenantId     String
  branchId     String
  code         String
  name         String
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([tenantId, branchId, code])
  @@map("cost_centers")
}

model ExchangeRate {
  id            String   @id @default(uuid())
  tenantId      String
  baseCurrency  String   @default("TZS")
  fromCurrency  String // e.g. "USD", "EUR", "GBP"
  toCurrency    String   @default("TZS")
  rate          Decimal  @db.Decimal(12, 6) // e.g. 2600.000000 TZS per 1 USD
  effectiveDate DateTime @default(now())
  source        String   @default("MANUAL") // MANUAL, BOT, CENTRAL_BANK
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fromCurrency, effectiveDate])
  @@map("exchange_rates")
}

model FinancialAnomaly {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String
  anomalyType  String // UNUSUAL_DISCOUNT, CASH_VARIANCE_SPIKE, DUPLICATE_PAYMENT, MARGIN_COLLAPSE, STOCK_WRITE_OFF_SPIKE
  severity     String    @default("WARNING") // INFO, WARNING, CRITICAL
  description  String
  entityType   String // Sale, Payment, Expense, CashSession, JournalEntry
  entityId     String
  detectedAt   DateTime  @default(now())
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, detectedAt])
  @@map("financial_anomalies")
}

// ==========================================
// PHASE 3: WORKFORCE & OPERATIONAL WORKFORCE CONTROL
// ==========================================

model Department {
  id             String          @id @default(uuid())
  tenantId       String
  branchId       String?
  name           String
  code           String
  description    String?
  managerId      String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  positions      JobPosition[]
  employees      Employee[]
  shiftTemplates ShiftTemplate[]

  @@unique([tenantId, code])
  @@map("departments")
}

model JobPosition {
  id                    String      @id @default(uuid())
  tenantId              String
  departmentId          String?
  title                 String
  positionCode          String
  jobDescription        String?
  payClassification     String? // HOURLY, SALARY, COMMISSION, PIECE_RATE
  defaultSalary         Decimal?    @db.Decimal(12, 2)
  defaultHourlyRate     Decimal?    @db.Decimal(10, 2)
  defaultCommissionRate Decimal?    @db.Decimal(5, 2)
  schedulePolicy        String?
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees             Employee[]

  @@unique([tenantId, positionCode])
  @@map("job_positions")
}

model Employee {
  id                 String                  @id @default(uuid())
  tenantId           String
  branchId           String?
  userId             String?
  employeeNumber     String
  firstName          String
  lastName           String
  preferredName      String?
  phone              String?
  email              String?
  address            String?
  emergencyContact   String?
