  @@map("saas_data_records")
}

model TraVfdConfig {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  enabled         Boolean  @default(false)
  endpoint        String   @default("")
  environment     String   @default("TEST")
  tin             String?
  certSerial      String?
  registrationId  String?
  efdSerial       String?
  receiptCode     String?
  routingKey      String?
  globalCounter   Int      @default(0)
  dailyCounter    Int      @default(0)
  counterDate     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId])
  @@index([tenantId, branchId])
  @@map("tra_vfd_configs")
}

model TraVfdFiscalization {
  id                  String         @id @default(uuid())
  tenantId            String
  branchId            String
  receiptId           String?        @unique
  transactionId       String
  deviceId            String
  chainSequence       Int            @default(0)
  previousReceiptHash String?
  receiptHash         String?
  state               String         @default("LOCAL_FISCAL_PENDING")
  requestPayload      Json
  responsePayload     Json?
  fiscalReceiptNumber String?
  fiscalCode          String?
  verificationCode    String?
  lastError           String?
  attempts            Int            @default(0)
  nextAttemptAt       DateTime?
  submittedAt         DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  verifiedAt          DateTime?
  reconciliationStatus String         @default("PENDING")
  reconciledAt         DateTime?
  reconciliationError  String?
  createdAt            DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  receipt             Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  outbox              TraVfdOutbox[]

  @@unique([tenantId, branchId, transactionId])
  @@unique([tenantId, branchId, deviceId, chainSequence])
  @@index([tenantId, branchId, state])
  @@index([tenantId, branchId, nextAttemptAt])
  @@map("tra_vfd_fiscalizations")
}

model TraVfdOutbox {
  id              String              @id @default(uuid())
  tenantId        String
  branchId        String
  fiscalizationId String
  operationId     String
  idempotencyKey  String
  payload         Json
  status          String              @default("PENDING")
  attempts        Int                 @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  lockedAt        DateTime?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalization   TraVfdFiscalization @relation(fields: [fiscalizationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, idempotencyKey])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, nextAttemptAt])
  @@map("tra_vfd_outbox")
}

model SyncControlState {
  id        Int      @id @default(1)
  syncEpoch String   @map("sync_epoch")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sync_control_state")
}
