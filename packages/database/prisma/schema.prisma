datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Tenant {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branches           Branch[]
  users              User[]
  roles              Role[]
  products           Product[]
  productVariants    ProductVariant[]
  categories         Category[]
  unitsOfMeasure     UnitOfMeasure[]
  customers          Customer[]
  suppliers          Supplier[]
  inventoryLocations InventoryLocation[]
  stockLedgers       StockLedger[]
  stockAdjustments   StockAdjustment[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  salesOrders        SalesOrder[]
  sales              Sale[]
  returns            Return[]
  payments           Payment[]
  cashSessions       CashSession[]
  expenses           Expense[]
  priceLists         PriceList[]
  taxes              Tax[]
  accounts           Account[]
  fiscalYears        FiscalYear[]
  accountingPeriods  AccountingPeriod[]
  journalEntries     JournalEntry[]
  customerInvoices   CustomerInvoice[]
  supplierInvoices   SupplierInvoice[]
  bankAccounts       BankAccount[]
  budgets            Budget[]
  costCenters        CostCenter[]
  exchangeRates      ExchangeRate[]
  financialAnomalies FinancialAnomaly[]
  departments        Department[]
  jobPositions       JobPosition[]
  employees          Employee[]
  employmentRecords  EmploymentRecord[]
  shiftTemplates     ShiftTemplate[]
  workforceSchedules WorkforceSchedule[]
  attendanceRecords  AttendanceRecord[]
  timesheets         Timesheet[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  workforceTasks     WorkforceTask[]
  workOrders         WorkOrder[]
  employeeSkills     EmployeeSkill[]
  employeeCertifications EmployeeCertification[]
  performanceReviews PerformanceReview[]
  commissionRecords  CommissionRecord[]
  payrollInputs      PayrollInput[]
  syncOperations     SyncOperation[]
  auditEvents        AuditEvent[]

  @@map("tenants")
}

model Branch {
  id                 String              @id @default(uuid())
  tenantId           String
  name               String
  code               String
  isMain             Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users              User[]
  products           Product[]
  productVariants    ProductVariant[]
  categories         Category[]
  unitsOfMeasure     UnitOfMeasure[]
  customers          Customer[]
  suppliers          Supplier[]
  inventoryLocations InventoryLocation[]
  stockLedgers       StockLedger[]
  stockAdjustments   StockAdjustment[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  salesOrders        SalesOrder[]
  sales              Sale[]
  returns            Return[]
  payments           Payment[]
  cashSessions       CashSession[]
  expenses           Expense[]
  priceLists         PriceList[]
  taxes              Tax[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  customerInvoices   CustomerInvoice[]
  supplierInvoices   SupplierInvoice[]
  bankAccounts       BankAccount[]
  budgets            Budget[]
  costCenters        CostCenter[]
  financialAnomalies FinancialAnomaly[]
  departments        Department[]
  employees          Employee[]
  shiftTemplates     ShiftTemplate[]
  workforceSchedules WorkforceSchedule[]
  attendanceRecords  AttendanceRecord[]
  timesheets         Timesheet[]
  leaveRequests      LeaveRequest[]
  workforceTasks     WorkforceTask[]
  workOrders         WorkOrder[]
  performanceReviews PerformanceReview[]
  commissionRecords  CommissionRecord[]
  payrollInputs      PayrollInput[]
  syncOperations     SyncOperation[]
  auditEvents        AuditEvent[]


  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id           String          @id @default(uuid())
  tenantId     String
  branchId     String
  email        String
  passwordHash String
  name         String
  roleId       String
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role         Role            @relation(fields: [roleId], references: [id])
  sessions     DeviceSession[]
  cashSessions CashSession[]

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@map("users")
}

model DeviceSession {
  id               String    @id @default(uuid())
  tenantId         String
  userId           String
  deviceId         String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, deviceId])
  @@map("device_sessions")
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
  @@map("categories")
}

model UnitOfMeasure {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, symbol])
  @@map("units_of_measure")
}

model InventoryLocation {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, code])
  @@map("inventory_locations")
}

model Customer {
  id             String       @id @default(uuid())
  tenantId       String
  branchId       String
  customerCode   String
  name           String
  phone          String?
  email          String?
  address        String?
  creditLimit    Decimal      @default(0) @db.Decimal(12, 2)
  currentBalance Decimal      @default(0) @db.Decimal(12, 2)
  openingBalance Decimal      @default(0) @db.Decimal(12, 2)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  salesOrders    SalesOrder[]
  sales          Sale[]
  returns        Return[]
  payments       Payment[]

  @@unique([tenantId, branchId, customerCode])
  @@index([tenantId, branchId])
  @@map("customers")
}

model Supplier {
  id                 String            @id @default(uuid())
  tenantId           String
  branchId           String
  supplierCode       String
  name               String
  phone              String?
  email              String?
  address            String?
  taxPin             String?
  outstandingBalance Decimal           @default(0) @db.Decimal(12, 2)
  status             String            @default("ACTIVE")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  payments           Payment[]

  @@unique([tenantId, branchId, supplierCode])
  @@index([tenantId, branchId])
  @@map("suppliers")
}

model Product {
  id           String           @id @default(uuid())
  tenantId     String
  branchId     String
  categoryId   String?
  name         String
  description  String?
  sku          String
  category     String           @default("General")
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryRel  Category?        @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  stockLedgers StockLedger[]
  saleLines    SaleLine[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId])
  @@map("products")
}

model ProductVariant {
  id                   String                @id @default(uuid())
  tenantId             String
  branchId             String
  productId            String
  name                 String
  sku                  String
  barcode              String?
  price                Decimal               @db.Decimal(12, 2)
  costPrice            Decimal               @db.Decimal(12, 2)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLedgers         StockLedger[]
  stockAdjustments     StockAdjustment[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  salesOrderItems      SalesOrderItem[]
  saleLines            SaleLine[]
  returnLines          ReturnLine[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId, productId])
  @@map("product_variants")
}

model StockLedger {
  id             String         @id @default(uuid())
  tenantId       String
  branchId       String
  productId      String
  variantId      String
  movementType   String // OPENING, PURCHASE, SALE, ADJUSTMENT, TRANSFER_IN, TRANSFER_OUT, RETURN, DAMAGE
  quantity       Decimal        @db.Decimal(12, 4)
  referenceType  String
  referenceId    String?
  occurredAt     DateTime
  deviceId       String
  operationId    String
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, variantId])
  @@index([tenantId, branchId, occurredAt])
  @@map("stock_ledgers")
}

model StockAdjustment {
  id              String         @id @default(uuid())
  tenantId        String
  branchId        String
  variantId       String
  adjustmentType  String // INCREASE, DECREASE, SET
  quantityChange  Decimal        @db.Decimal(12, 4)
  reason          String
  referenceNote   String?
  status          String         @default("COMPLETED")
  createdByUserId String
  deviceId        String
  operationId     String
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, variantId])
  @@map("stock_adjustments")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  tenantId         String
  branchId         String
  orderNumber      String
  supplierId       String
  status           String              @default("DRAFT") // DRAFT, APPROVED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalAmount      Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  createdById      String?
  approvedById     String?
  orderedAt        DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items            PurchaseOrderItem[]
  purchaseReceipts PurchaseReceipt[]

  @@unique([tenantId, branchId, orderNumber])
  @@index([tenantId, branchId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Decimal        @db.Decimal(12, 4)
  quantityReceived Decimal        @default(0) @db.Decimal(12, 4)
  unitCost         Decimal        @db.Decimal(12, 2)
  totalCost        Decimal        @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id              String                @id @default(uuid())
  tenantId        String
  branchId        String
  receiptNumber   String
  purchaseOrderId String?
  supplierId      String
  receivedAt      DateTime              @default(now())
  createdById     String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  items           PurchaseReceiptItem[]
  payments        Payment[]

  @@unique([tenantId, branchId, receiptNumber])
  @@index([tenantId, branchId, supplierId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                String          @id @default(uuid())
  purchaseReceiptId String
  variantId         String
  quantityReceived  Decimal         @db.Decimal(12, 4)
  unitCost          Decimal         @db.Decimal(12, 2)
  totalCost         Decimal         @db.Decimal(12, 2)
  batchNumber       String?
  expiryDate        DateTime?
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("purchase_receipt_items")
}

model SalesOrder {
  id          String           @id @default(uuid())
  tenantId    String
  branchId    String
  orderNumber String
  customerId  String?
  status      String           @default("PENDING") // PENDING, CONFIRMED, FULFILLED, CANCELLED
  totalAmount Decimal          @default(0) @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer?        @relation(fields: [customerId], references: [id])
  items       SalesOrderItem[]

  @@unique([tenantId, branchId, orderNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String         @id @default(uuid())
  salesOrderId String
  variantId    String
  quantity     Decimal        @db.Decimal(12, 4)
  unitPrice    Decimal        @db.Decimal(12, 2)
  totalPrice   Decimal        @db.Decimal(12, 2)
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

model Sale {
  id             String      @id @default(uuid())
  tenantId       String
  branchId       String
  saleNumber     String
  customerId     String?
  cashSessionId  String?
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal     @default(0) @db.Decimal(12, 2)
  totalCost      Decimal     @default(0) @db.Decimal(12, 2)
  grossProfit    Decimal     @default(0) @db.Decimal(12, 2)
  status         String      @default("COMPLETED") // COMPLETED, CANCELLED, REFUNDED
  paymentStatus  String      @default("PAID") // PAID, PARTIAL, UNPAID
  deviceId       String
  operationId    String
  idempotencyKey String      @unique
  soldById       String?
  soldAt         DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       Customer?   @relation(fields: [customerId], references: [id])
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id])
  lines          SaleLine[]
  payments       Payment[]
  returns        Return[]

  @@unique([tenantId, branchId, saleNumber])
  @@index([tenantId, branchId, soldAt])
  @@map("sales")
}

model SaleLine {
  id             String         @id @default(uuid())
  saleId         String
  productId      String
  variantId      String
  quantity       Decimal        @db.Decimal(12, 4)
  unitPrice      Decimal        @db.Decimal(12, 2)
  unitCost       Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal        @db.Decimal(12, 2)
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([saleId, variantId])
  @@map("sale_lines")
}

model Return {
  id                String       @id @default(uuid())
  tenantId          String
  branchId          String
  returnNumber      String
  originalSaleId    String?
  customerId        String?
  reason            String
  refundType        String       @default("CASH") // CASH, STORE_CREDIT, BANK, MOBILE_MONEY
  totalRefundAmount Decimal      @db.Decimal(12, 2)
  status            String       @default("COMPLETED")
  authorizedById    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  originalSale      Sale?        @relation(fields: [originalSaleId], references: [id])
  customer          Customer?    @relation(fields: [customerId], references: [id])
  lines             ReturnLine[]

  @@unique([tenantId, branchId, returnNumber])
  @@map("returns")
}

model ReturnLine {
  id               String         @id @default(uuid())
  returnId         String
  variantId        String
  quantityReturned Decimal        @db.Decimal(12, 4)
  refundUnitPrice  Decimal        @db.Decimal(12, 2)
  refundLineTotal  Decimal        @db.Decimal(12, 2)
  condition        String         @default("GOOD") // GOOD, DAMAGED, DEFECTIVE
  returnRel        Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("return_lines")
}

model Payment {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String
  paymentNumber     String
  saleId            String?
  purchaseReceiptId String?
  customerId        String?
  supplierId        String?
  amount            Decimal          @db.Decimal(12, 2)
  paymentMethod     String           @default("CASH") // CASH, CARD, BANK, MOBILE_MONEY, CREDIT, OTHER
  provider          String? // MPESA, AIRTEL_MONEY, TIGO_PESA, HALOPESA, NMB, CRDB, CASH
  providerReference String?
  status            String           @default("COMPLETED") // COMPLETED, PENDING, FAILED, REFUNDED
  paidAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sale              Sale?            @relation(fields: [saleId], references: [id])
  purchaseReceipt   PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id])
  customer          Customer?        @relation(fields: [customerId], references: [id])
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])

  @@unique([tenantId, branchId, paymentNumber])
  @@index([tenantId, branchId, paidAt])
  @@map("payments")
}

model CashSession {
  id                String    @id @default(uuid())
  tenantId          String
  branchId          String
  sessionNumber     String
  cashierId         String
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  openingCash       Decimal   @default(0) @db.Decimal(12, 2)
  closingCash       Decimal?  @db.Decimal(12, 2)
  expectedCash      Decimal   @default(0) @db.Decimal(12, 2)
  actualCash        Decimal?  @db.Decimal(12, 2)
  cashSalesTotal    Decimal   @default(0) @db.Decimal(12, 2)
  cashRefundsTotal  Decimal   @default(0) @db.Decimal(12, 2)
  cashExpensesTotal Decimal   @default(0) @db.Decimal(12, 2)
  variance          Decimal?  @db.Decimal(12, 2)
  status            String    @default("OPEN") // OPEN, ACTIVE, CLOSE_REQUESTED, CLOSED
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier           User      @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  sales             Sale[]
  expenses          Expense[]

  @@unique([tenantId, branchId, sessionNumber])
  @@index([tenantId, branchId, cashierId])
  @@map("cash_sessions")
}

model Expense {
  id            String       @id @default(uuid())
  tenantId      String
  branchId      String
  cashSessionId String?
  category      String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  authorizedById String?
  incurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  @@index([tenantId, branchId, incurredAt])
  @@map("expenses")
}

model PriceList {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  currency  String   @default("TZS")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, code])
  @@map("price_lists")
}

model Tax {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  name        String
  code        String
  rate        Decimal  @db.Decimal(5, 2) // e.g., 18.00 for 18%
  isInclusive Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, code])
  @@map("taxes")
}

model SyncOperation {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String
  deviceId        String
  operationId     String
  entityType      String // Product, ProductVariant, StockAdjustment, StockLedger, Customer, Supplier, Sale, PurchaseOrder, Payment, CashSession
  entityId        String
  operationType   String // CREATE, UPDATE, DELETE
  payload         Json
  status          String    @default("PROCESSED")
  idempotencyKey  String    @unique
  clientCreatedAt DateTime
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceId, operationId])
  @@index([tenantId, branchId, createdAt])
  @@map("sync_operations")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  userId     String
  deviceId   String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, createdAt])
  @@map("audit_events")
}

model SyncDeadLetter {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  deviceId    String
  operationId String
  entityType  String
  payload     Json
  errorReason String
  createdAt   DateTime @default(now())

  @@index([tenantId, branchId, createdAt])
  @@map("sync_dead_letters")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  tenantId    String?
  branchId    String?
  key         String
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, tenantId, branchId])
  @@map("feature_flags")
}

// =========================================================================
// PHASE 2: FINANCE & OPERATIONAL CONTROL MODELS
// =========================================================================

model Account {
  id               String         @id @default(uuid())
  tenantId         String
  branchId         String?
  accountCode      String
  name             String
  accountClass     String         // ASSET, LIABILITY, EQUITY, REVENUE, COGS, EXPENSE, OTHER_INCOME, OTHER_EXPENSE
  accountGroup     String         // e.g. CURRENT_ASSET, CASH, BANK, ACCOUNTS_RECEIVABLE, INVENTORY, CURRENT_LIABILITY, ACCOUNTS_PAYABLE, TAX_PAYABLE
  currency         String         @default("TZS")
  isSystem         Boolean        @default(false)
  isActive         Boolean        @default(true)
  currentBalance   Decimal        @default(0) @db.Decimal(14, 2)
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?        @relation(fields: [branchId], references: [id])
  journalLines     JournalLine[]
  budgetLines      BudgetLine[]

  @@unique([tenantId, accountCode])
  @@index([tenantId, accountClass])
  @@map("accounts")
}

model FiscalYear {
  id                String             @id @default(uuid())
  tenantId          String
  name              String             // e.g. "FY 2026"
  startDate         DateTime
  endDate           DateTime
  status            String             @default("OPEN") // OPEN, CLOSING, CLOSED, LOCKED
  isClosed          Boolean            @default(false)
  closedAt          DateTime?
  closedById        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountingPeriods AccountingPeriod[]

  @@unique([tenantId, name])
  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String         @id @default(uuid())
  tenantId     String
  fiscalYearId String
  periodNumber Int            // 1 to 12
  name         String         // e.g. "2026-01"
  startDate    DateTime
  endDate      DateTime
  status       String         @default("OPEN") // OPEN, CLOSING, CLOSED, LOCKED
  closedAt     DateTime?
  closedById   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals     JournalEntry[]

  @@unique([tenantId, fiscalYearId, periodNumber])
  @@map("accounting_periods")
}

model JournalEntry {
  id                   String            @id @default(uuid())
  tenantId             String
  branchId             String
  accountingPeriodId   String?
  journalNumber        String
  entryDate            DateTime          @default(now())
  postingDate          DateTime          @default(now())
  sourceType           String            // SALE, PURCHASE, PAYMENT, EXPENSE, RETURN, TRANSFER, CASH_SESSION, MANUAL, REVERSAL
  sourceId             String?
  description          String
  currency             String            @default("TZS")
  exchangeRate         Decimal           @default(1.0) @db.Decimal(10, 4)
  totalDebit           Decimal           @db.Decimal(14, 2)
  totalCredit          Decimal           @db.Decimal(14, 2)
  status               String            @default("POSTED") // DRAFT, PENDING_APPROVAL, POSTED, REVERSED
  isReversal           Boolean           @default(false)
  reversalOfJournalId  String?
  reversalReason       String?
  createdById          String?
  postedById           String?
  postedAt             DateTime?         @default(now())
  idempotencyKey       String?           @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  accountingPeriod     AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id])
  lines                JournalLine[]

  @@unique([tenantId, branchId, journalNumber])
  @@index([tenantId, branchId, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String        @id @default(uuid())
  journalEntryId String
  accountId      String
  costCenterId   String?
  description    String?
  debit          Decimal       @default(0) @db.Decimal(14, 2)
  credit         Decimal       @default(0) @db.Decimal(14, 2)
  currency       String        @default("TZS")
  exchangeRate   Decimal       @default(1.0) @db.Decimal(10, 4)
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?   @relation(fields: [costCenterId], references: [id])

  @@index([journalEntryId, accountId])
  @@map("journal_lines")
}

model CustomerInvoice {
  id             String                @id @default(uuid())
  tenantId       String
  branchId       String
  customerId     String
  saleId         String?
  invoiceNumber  String
  invoiceDate    DateTime              @default(now())
  dueDate        DateTime
  subtotal       Decimal               @db.Decimal(14, 2)
  taxTotal       Decimal               @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal               @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal               @db.Decimal(14, 2)
  amountPaid     Decimal               @default(0) @db.Decimal(14, 2)
  balanceDue     Decimal               @db.Decimal(14, 2)
  status         String                @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines          CustomerInvoiceLine[]
  allocations    PaymentAllocation[]

  @@unique([tenantId, branchId, invoiceNumber])
  @@index([tenantId, customerId, status])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id                String          @id @default(uuid())
  customerInvoiceId String
  variantId         String?
  description       String
  quantity          Decimal         @db.Decimal(12, 4)
  unitPrice         Decimal         @db.Decimal(14, 2)
  taxRate           Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  customerInvoice   CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)

  @@map("customer_invoice_lines")
}

model SupplierInvoice {
  id                String                @id @default(uuid())
  tenantId          String
  branchId          String
  supplierId        String
  purchaseReceiptId String?
  invoiceNumber     String
  invoiceDate       DateTime              @default(now())
  dueDate           DateTime
  subtotal          Decimal               @db.Decimal(14, 2)
  taxTotal          Decimal               @default(0) @db.Decimal(14, 2)
  grandTotal        Decimal               @db.Decimal(14, 2)
  amountPaid        Decimal               @default(0) @db.Decimal(14, 2)
  balanceDue        Decimal               @db.Decimal(14, 2)
  status            String                @default("RECEIVED") // RECEIVED, APPROVED, PARTIALLY_PAID, PAID, OVERDUE, REJECTED
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines             SupplierInvoiceLine[]
  allocations       PaymentAllocation[]

  @@unique([tenantId, branchId, invoiceNumber])
  @@index([tenantId, supplierId, status])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id                String          @id @default(uuid())
  supplierInvoiceId String
  variantId         String?
  description       String
  quantity          Decimal         @db.Decimal(12, 4)
  unitCost          Decimal         @db.Decimal(14, 2)
  taxRate           Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  @@map("supplier_invoice_lines")
}

model PaymentAllocation {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String
  paymentId         String
  customerInvoiceId String?
  supplierInvoiceId String?
  allocatedAmount   Decimal          @db.Decimal(14, 2)
  allocatedAt       DateTime         @default(now())
  createdById       String?
  createdAt         DateTime         @default(now())
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  @@index([tenantId, paymentId])
  @@map("payment_allocations")
}

model BankAccount {
  id             String            @id @default(uuid())
  tenantId       String
  branchId       String
  accountName    String
  bankName       String            // e.g. "NMB", "CRDB", "Stanbic", "NBC"
  accountNumber  String
  currency       String            @default("TZS")
  openingBalance Decimal           @default(0) @db.Decimal(14, 2)
  currentBalance Decimal           @default(0) @db.Decimal(14, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]

  @@unique([tenantId, accountNumber])
  @@map("bank_accounts")
}

model BankTransaction {
  id                  String      @id @default(uuid())
  tenantId            String
  branchId            String
  bankAccountId       String
  transactionDate     DateTime
  transactionType     String      // DEPOSIT, WITHDRAWAL, TRANSFER_IN, TRANSFER_OUT, FEE, INTEREST, ADJUSTMENT
  amount              Decimal     @db.Decimal(14, 2)
  reference           String
  description         String?
  reconciled          Boolean     @default(false)
  reconciledAt        DateTime?
  matchedJournalLineId String?
  createdAt           DateTime    @default(now())
  bankAccount         BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, transactionDate])
  @@map("bank_transactions")
}

model Budget {
  id          String       @id @default(uuid())
  tenantId    String
  branchId    String
  name        String
  fiscalYear  String       // e.g. "2026"
  period      String?      // Optional month/quarter: "Q1", "2026-01"
  totalBudget Decimal      @db.Decimal(14, 2)
  status      String       @default("APPROVED") // DRAFT, APPROVED, ARCHIVED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines       BudgetLine[]

  @@unique([tenantId, branchId, name, fiscalYear])
  @@map("budgets")
}

model BudgetLine {
  id             String      @id @default(uuid())
  budgetId       String
  accountId      String
  costCenterId   String?
  budgetedAmount Decimal     @db.Decimal(14, 2)
  actualAmount   Decimal     @default(0) @db.Decimal(14, 2)
  varianceAmount Decimal     @default(0) @db.Decimal(14, 2)
  budget         Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id])

  @@map("budget_lines")
}

model CostCenter {
  id           String        @id @default(uuid())
  tenantId     String
  branchId     String
  code         String
  name         String
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([tenantId, branchId, code])
  @@map("cost_centers")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  tenantId     String
  baseCurrency String   @default("TZS")
  fromCurrency String   // e.g. "USD", "EUR", "GBP"
  toCurrency   String   @default("TZS")
  rate         Decimal  @db.Decimal(12, 6) // e.g. 2600.000000 TZS per 1 USD
  effectiveDate DateTime @default(now())
  source       String   @default("MANUAL") // MANUAL, BOT, CENTRAL_BANK
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fromCurrency, effectiveDate])
  @@map("exchange_rates")
}

model FinancialAnomaly {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  anomalyType String   // UNUSUAL_DISCOUNT, CASH_VARIANCE_SPIKE, DUPLICATE_PAYMENT, MARGIN_COLLAPSE, STOCK_WRITE_OFF_SPIKE
  severity    String   @default("WARNING") // INFO, WARNING, CRITICAL
  description String
  entityType  String   // Sale, Payment, Expense, CashSession, JournalEntry
  entityId    String
  detectedAt  DateTime @default(now())
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedById String?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, detectedAt])
  @@map("financial_anomalies")
}

// ==========================================
// PHASE 3: WORKFORCE & OPERATIONAL WORKFORCE CONTROL
// ==========================================

model Department {
  id          String         @id @default(uuid())
  tenantId    String
  branchId    String?
  name        String
  code        String
  description String?
  managerId   String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  positions   JobPosition[]
  employees   Employee[]
  shiftTemplates ShiftTemplate[]

  @@unique([tenantId, code])
  @@map("departments")
}

model JobPosition {
  id                 String             @id @default(uuid())
  tenantId           String
  departmentId       String?
  title              String
  positionCode       String
  jobDescription     String?
  payClassification  String?            // HOURLY, SALARY, COMMISSION, PIECE_RATE
  defaultSalary      Decimal?           @db.Decimal(12, 2)
  defaultHourlyRate  Decimal?           @db.Decimal(10, 2)
  defaultCommissionRate Decimal?        @db.Decimal(5, 2)
  schedulePolicy     String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees          Employee[]

  @@unique([tenantId, positionCode])
  @@map("job_positions")
}

model Employee {
  id                 String                  @id @default(uuid())
  tenantId           String
  branchId           String?
  userId             String?
  employeeNumber     String
  firstName          String
  lastName           String
  preferredName      String?
  phone              String?
  email              String?
  address            String?
  emergencyContact   String?
  dateOfBirth        DateTime?
  status             String                  @default("ACTIVE") // ACTIVE, ON_LEAVE, SUSPENDED, TERMINATED
  hireDate           DateTime                @default(now())
  terminationDate    DateTime?
  departmentId       String?
  positionId         String?
  managerId          String?
  workType           String                  @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN, CASUAL
  contractType       String                  @default("PERMANENT") // PERMANENT, FIXED_TERM, PROBATION
  baseSalary         Decimal?                @db.Decimal(12, 2)
  hourlyRate         Decimal?                @db.Decimal(10, 2)
  commissionRate     Decimal?                @db.Decimal(5, 2)
  pinCodeHash        String?
  profilePhotoUrl    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department         Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           JobPosition?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentRecords  EmploymentRecord[]
  schedules          WorkforceSchedule[]
  attendanceRecords  AttendanceRecord[]
  timesheets         Timesheet[]
  leaveRequests      LeaveRequest[]
  assignedTasks      WorkforceTask[]
  assignedWorkOrders WorkOrder[]
  skills             EmployeeSkill[]
  certifications     EmployeeCertification[]
  performanceReviews PerformanceReview[]     @relation("EmployeeReviews")
  commissions        CommissionRecord[]
  payrollInputs      PayrollInput[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, branchId, status])
  @@map("employees")
}

model EmploymentRecord {
  id             String    @id @default(uuid())
  tenantId       String
  employeeId     String
  effectiveDate  DateTime  @default(now())
  endDate        DateTime?
  changeType     String    // HIRE, PROMOTION, TRANSFER, PAY_ADJUSTMENT, STATUS_CHANGE, TERMINATION
  departmentId   String?
  positionId     String?
  branchId       String?
  managerId      String?
  contractType   String?
  payRate        Decimal?  @db.Decimal(12, 2)
  reason         String?
  createdById    String
  createdAt      DateTime  @default(now())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveDate])
  @@map("employment_records")
}

model ShiftTemplate {
  id                   String              @id @default(uuid())
  tenantId             String
  branchId             String?
  departmentId         String?
  name                 String
  startTime            String              // "08:00"
  endTime              String              // "17:00"
  breakDurationMinutes Int                 @default(60)
  workdays             Int[]               // [1,2,3,4,5] (Monday=1, Sunday=7)
  requiredHeadcount    Int                 @default(1)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department           Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules            WorkforceSchedule[]

  @@map("shift_templates")
}

model WorkforceSchedule {
  id              String         @id @default(uuid())
  tenantId        String
  branchId        String
  employeeId      String
  shiftTemplateId String?
  date            DateTime
  startTime       String
  endTime         String
  status          String         @default("PUBLISHED") // DRAFT, PUBLISHED, ACKNOWLEDGED, ACTIVE, COMPLETED, CANCELLED
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  attendance      AttendanceRecord[]

  @@index([tenantId, branchId, date])
  @@index([tenantId, employeeId, date])
  @@map("workforce_schedules")
}

model AttendanceRecord {
  id                 String             @id @default(uuid())
  tenantId           String
  branchId           String
  employeeId         String
  scheduleId         String?
  workDate           DateTime
  clockIn            DateTime
  clockOut           DateTime?
  breakMinutes       Int                @default(0)
  regularMinutes     Int                @default(0)
  overtimeMinutes    Int                @default(0)
  status             String             @default("PRESENT") // PRESENT, LATE, EARLY_LEAVE, OVERTIME, ABSENT, EXCUSED
  method             String             @default("STANDARD") // STANDARD, PIN, QR, DEVICE, GEOLOCATION, BIOMETRIC
  pinVerified        Boolean            @default(false)
  qrCode             String?
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  deviceId           String?
  idempotencyKey     String
  supervisorApproved Boolean            @default(false)
  approvedById       String?
  approvedAt         DateTime?
  correctionReason   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule           WorkforceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, workDate])
  @@index([tenantId, employeeId, workDate])
  @@map("attendance_records")
}

model Timesheet {
  id                    String    @id @default(uuid())
  tenantId              String
  branchId              String
  employeeId            String
  periodStart           DateTime
  periodEnd             DateTime
  totalScheduledMinutes Int       @default(0)
  totalWorkedMinutes    Int       @default(0)
  totalRegularMinutes   Int       @default(0)
  totalOvertimeMinutes  Int       @default(0)
  totalBreakMinutes     Int       @default(0)
  totalAbsentMinutes    Int       @default(0)
  totalApprovedMinutes  Int       @default(0)
  status                String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, LOCKED
  submittedAt           DateTime?
  approvedAt            DateTime?
  approvedById          String?
  rejectionReason       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, periodStart, periodEnd])
  @@index([tenantId, branchId, periodStart])
  @@map("timesheets")
}

model LeaveType {
  id                   String         @id @default(uuid())
  tenantId             String
  name                 String
  code                 String
  isPaid               Boolean        @default(true)
  defaultAllowanceDays Int            @default(21)
  requiresProof        Boolean        @default(false)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests        LeaveRequest[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

model LeaveRequest {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Decimal   @db.Decimal(5, 1)
  partialDay      String?   // FULL, FIRST_HALF, SECOND_HALF
  reason          String?
  status          String    @default("PENDING") // DRAFT, PENDING, APPROVED, REJECTED, CANCELLED
  documentUrl     String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, startDate])
  @@index([tenantId, employeeId, startDate])
  @@map("leave_requests")
}

model WorkforceTask {
  id                 String    @id @default(uuid())
  tenantId           String
  branchId           String
  title              String
  description        String?
  taskType           String    @default("GENERAL") // GENERAL, STOCK_COUNT, MAINTENANCE, CLEANING, SERVICE, INSPECTION
  priority           String    @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  status             String    @default("BACKLOG") // BACKLOG, ASSIGNED, IN_PROGRESS, BLOCKED, COMPLETED, VERIFIED, CANCELLED
  assignedEmployeeId String?
  assignedTeam       String?
  dueDate            DateTime?
  checklist          Json?     // [{ item: "Check cooler temp", done: true }]
  attachments        String[]
  relatedEntityType  String?   // Product, Sale, Purchase, WorkOrder
  relatedEntityId    String?
  completedAt        DateTime?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, status])
  @@map("workforce_tasks")
}

model WorkOrder {
  id                 String    @id @default(uuid())
  tenantId           String
  branchId           String
  workOrderNumber    String
  customerId         String?
  projectId          String?
  title              String
  description        String?
  priority           String    @default("MEDIUM")
  status             String    @default("DRAFT") // DRAFT, SCHEDULED, IN_PROGRESS, ON_HOLD, COMPLETED, INVOICED, CANCELLED
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  assignedEmployeeId String?
  laborHours         Decimal   @default(0) @db.Decimal(8, 2)
  laborRate          Decimal   @default(0) @db.Decimal(10, 2)
  laborCostTotal     Decimal   @default(0) @db.Decimal(12, 2)
  materialsCostTotal Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal   @default(0) @db.Decimal(12, 2)
  notes              String?
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, workOrderNumber])
  @@index([tenantId, branchId, status])
  @@map("work_orders")
}

model EmployeeSkill {
  id               String   @id @default(uuid())
  tenantId         String
  employeeId       String
  skillName        String
  proficiencyLevel String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  yearsExperience  Decimal? @db.Decimal(4, 1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, skillName])
  @@map("employee_skills")
}

model EmployeeCertification {
  id                String    @id @default(uuid())
  tenantId          String
  employeeId        String
  certificationName String
  issuingBody       String
  certificateNumber String?
  issueDate         DateTime
  expiryDate        DateTime?
  isVerified        Boolean   @default(false)
  verifiedById      String?
  verifiedAt        DateTime?
  documentUrl       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, expiryDate])
  @@map("employee_certifications")
}

model PerformanceReview {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String
  employeeId      String
  reviewerId      String
  reviewPeriod    String    // e.g. "2026-Q1", "2026-ANNUAL"
  rating          Decimal   @db.Decimal(3, 2) // 1.00 to 5.00
  strengths       String?
  improvements    String?
  goals           Json?     // [{ goal: "Achieve 98% stock accuracy", status: "ACHIEVED" }]
  status          String    @default("COMPLETED") // DRAFT, SUBMITTED, ACKNOWLEDGED, COMPLETED
  submittedAt     DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee        Employee  @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, reviewPeriod])
  @@map("performance_reviews")
}

model CommissionRecord {
  id               String    @id @default(uuid())
  tenantId         String
  branchId         String
  employeeId       String
  saleId           String?
  workOrderId      String?
  period           String    // "2026-08"
  salesAmount      Decimal   @db.Decimal(12, 2)
  commissionRate   Decimal   @db.Decimal(5, 2)
  commissionAmount Decimal   @db.Decimal(12, 2)
  status           String    @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, period])
  @@map("commission_records")
}

model PayrollInput {
  id               String    @id @default(uuid())
  tenantId         String
  branchId         String
  employeeId       String
  periodStart      DateTime
  periodEnd        DateTime
  basicHours       Decimal   @default(0) @db.Decimal(8, 2)
  overtimeHours    Decimal   @default(0) @db.Decimal(8, 2)
  regularPay       Decimal   @default(0) @db.Decimal(12, 2)
  overtimePay      Decimal   @default(0) @db.Decimal(12, 2)
  commissionsTotal Decimal   @default(0) @db.Decimal(12, 2)
  bonusesTotal     Decimal   @default(0) @db.Decimal(12, 2)
  allowancesTotal  Decimal   @default(0) @db.Decimal(12, 2)
  deductionsTotal  Decimal   @default(0) @db.Decimal(12, 2)
  grossPay         Decimal   @default(0) @db.Decimal(12, 2)
  status           String    @default("CALCULATED") // CALCULATED, APPROVED, EXPORTED, LOCKED
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, periodStart, periodEnd])
  @@index([tenantId, branchId, periodStart])
  @@map("payroll_inputs")
}