{
  "name": "kwakopos2-monorepo",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/config",
    "packages/domain",
    "packages/database",
    "packages/auth",
    "packages/sync",
    "packages/observability",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration && npm run test:sync",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:sync": "vitest run tests/sync",
    "test:browser": "playwright test",
    "certify": "tsx scripts/certification/runCertification.ts",
    "certify:campaign": "tsx scripts/certification/fullSystemCertificationCampaign.ts",
    "certify:security": "tsx scripts/security/runSecurityCertification.ts",
    "certify:resilience": "tsx scripts/certification/runResilienceCertification.ts",
    "certify:performance": "tsx scripts/certification/runPerformanceCertification.ts",
    "certify:reliability": "tsx scripts/certification/runReliabilityCertification.ts",
    "certify:commercial": "tsx scripts/certification/runCommercialCertification.ts",
    "certify:production": "tsx scripts/certification/runProductionCertification.ts",
    "certify:prove": "tsx scripts/release/prove-production-release.ts",
    "db:generate": "npm run db:generate --workspace=@kwakopos2/database",
    "db:push": "npm run db:push --workspace=@kwakopos2/database",
    "release:deploy-candidate": "tsx scripts/release/deploy-candidate.ts",
    "release:promote": "tsx scripts/release/promote-revision.ts",
    "production:browser:install": "npx playwright install --with-deps chromium",
    "production:certify:deployed": "tsx scripts/release/certify-deployed.ts",
    "production:browser": "tsx scripts/release/canonical-cross-client-test.ts",
    "synthetic": "tsx scripts/ops/synthetic-monitor.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.24",
    "eslint": "^8.57.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
