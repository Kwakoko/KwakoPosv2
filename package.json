{
  "name": "kwakopos2-monorepo",
  "version": "2.1.0",
  "private": true,
  "description": "KwakoPos 2.0 Foundation - Clean, Modular, Offline-First, Multi-Tenant SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "start": "node apps/api/dist/server.js",
    "build": "npm run db:generate && npm run build --workspace=@kwakopos2/contracts && npm run build --workspace=@kwakopos2/config && npm run build --workspace=@kwakopos2/domain && npm run build --workspace=@kwakopos2/database && npm run build --workspace=@kwakopos2/auth && npm run build --workspace=@kwakopos2/sync && npm run build --workspace=@kwakopos2/observability && npm run build --workspace=@kwakopos2/api && npm run build --workspace=@kwakopos2/web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:sync": "vitest run tests/sync",
    "test:invariants": "vitest run tests/unit/invariants.test.ts",
    "certify": "tsx scripts/certification/runCertification.ts",
    "production:certify:deployed": "tsx scripts/release/certify-deployed.ts",
    "production:browser": "npx playwright test tests/browser/production-browser.spec.mjs --config=playwright.production.config.mjs",
    "production:browser:install": "npx playwright install --with-deps chromium",
    "release:deploy-candidate": "tsx scripts/release/deploy-candidate.ts",
    "release:promote": "tsx scripts/release/promote-revision.ts",
    "release:prove": "tsx scripts/release/prove-production-release.ts",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/database/prisma/schema.prisma",
    "dev:api": "npm run dev --workspace=@kwakopos2/api",
    "dev:web": "npm run dev --workspace=@kwakopos2/web"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^1.2.2"
  }
}
